pipeline {
    agent any
    
    parameters {
    string(name: "App_Version", description: "provide application version")
   }
    environment {
       DOCKERHUB_CREDENTIALS=credentials("dokcerhub")
       K8S_REPO = 'https://github.com/farooq-devops/jenkinsk8s'
       IMAGE_REPO = "farooqdevops/datastore"
       IMAGE_TAG = "${env.BUILD_NUMBER}"
   }

    stages {
        stage("Checkout") {
          steps {
            checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/farooq-devops/DataStore.git']])
          }
    }
    stage("Maven Build") {
        steps {
            sh """
              echo "------- Building Apllication ------"
              mvn clean package
              echo "------ Application Built Successfully -------"
            """
        }
    }
     stage("Execute Testcases") {
      steps {
        sh """
          echo "-------- Executing Testcases --------"
          mvn test
          echo "-------- Testcases Execution Complete --------"
        """
      }
    }
    stage("Pushing Artifacts To S3") {
        steps {
            sh """
               echo "------Pushing Artifacts To S3------"
               aws s3 cp ./target/*.jar s3://datastore-app-jenkins/ 
               echo "------ Pushing Artifacts To S3 Completed ------"
               """
        }
    }
    stage("Creating Docker Image") {
      steps {
        sh """
          echo "------ Building Docker Image -------"
          docker build -t datastore:"${App_Version}" .
          echo "------ Image Successfully Built -------"
          """
      }
    }
   stage("Scaning Docker Image") {
      steps {
        sh """
          echo "-------- Scanning Docker Image --------"
          trivy image datastore:"${App_Version}"
          echo "-------- Scanning Docker Image Complete --------"
        """
      }
    }
  stage("Tagging Docker Image") {
      steps{
        sh """
          echo "-------- Tagging Docker Image --------"
          docker tag datastore:"${App_Version}" farooqmohammed97/datastore:"${App_Version}"
          echo "-------- Tagging Docker Image Completed."
        """
      }
    }
    stage("Loggingin & Pushing Docker image To DockerHub") {
      steps {
        sh """
          echo "-------- Logging To DockerHub --------"
          docker login -u $DOCKERHUB_CREDENTIALS_USR --password $DOCKERHUB_CREDENTIALS_PSW
          echo "-------- DockerHub Login Successful --------"

          echo "-------- Pushing Docker Image To DockerHub --------"
          docker push farooqmohammed97/datastore:"${App_Version}"
          echo "-------- Docker Image Pushed Successfully --------"
        """
      }
    }  
    stage("cleanup") {
      steps {
        sh """
           echo "-------- Cleaning Up Jenkins Machine --------"
           docker image prune -a -f
           echo "-------- Clean Up Successful --------"
        """
      }
    }
   stage("deploy to k8s") {
    steps {
        script {
            echo "Cloning K8s Manifest Repo..."
            sh """
                rm -rf k8s
                git clone ${K8S_REPO} k8s
            """

            echo "Updating Manifest Files With New Image Tag..."
            sh """
               cd k8s
               sed -i 's|image: .*$|image: ${IMAGE_REPO}:${IMAGE_TAG}|g' deployment.yaml
            """

            echo "Commit & Push Back to Git..."
            sh """
               cd k8s
               git config user.email "mohdfarooq2526@gmail.com"
               git config user.name "jenkins"
               git add .
               git commit -m "Updated image to ${IMAGE_REPO}:${IMAGE_TAG}"
               git push origin main
            """
        }
    }    
    }
}
}
