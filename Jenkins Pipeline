pipeline {
    agent any
    stages {
        stage("Checkout") {
          steps {
            checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/farooq-devops/DataStore.git']])
          }
    }
        stage("Maven Build") {
          steps {
            sh """
              echo "------- Building Apllication ------"
              mvn clean package
              echo "------ Application Built Successfully -------"
             """
        }
    }
      stage("Execute Testcases") {
        steps {
         sh """
          echo "-------- Executing Testcases --------"
          mvn test
          echo "-------- Testcases Execution Complete --------"
          """
      }
    }
      stage("static code analisys") {
       steps{
         script {
            def SonarQubecredentialsId = 'sonarqube'
            staticCodeAnalysis(SonarQubecredentialsId)
          }
        }
    }
      stage("Quality Gate") {
       steps {
        timeout(time: 1, unit: 'HOURS') {
        waitForQualityGate abortPipeline: true
        }
      }
    }
}
}
