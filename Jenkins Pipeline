pipeline {
    agent any

    stages{
        stage("Checkout") {
            steps {
            checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/farooq-devops/DataStore.git']])}
        }
    }
    stage("maven Build") {
        steps {
            sh """
            echo "--------Building Application --------"
            mvn clean package
            echo "-------- Application Built Successfully --------"
            """
        }
    }
}
